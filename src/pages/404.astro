---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
---

<BaseLayout
  title="Page not found | Omar Daniel"
  description="This page doesn't exist."
>
  <Nav />
  <main class="max-w-content mx-auto px-6 py-24">
    <p class="label mb-3">404</p>
    <h1 class="font-display text-3xl sm:text-4xl font-semibold mb-4">
      Well, this path <span class="relative inline-block whitespace-nowrap">led nowhere<svg viewBox="0 0 160 10" preserveAspectRatio="none" class="absolute left-0 -bottom-1.5 w-full h-2.5" aria-hidden="true">
          <path d="M2,6 Q40,1 80,6 T158,5" fill="none" stroke="var(--color-amber)" stroke-width="3" stroke-linecap="round" />
        </svg></span>.
    </h1>
    <p class="text-muted max-w-md mb-7 leading-relaxed">
      The page you're looking for doesn't exist. Maybe it moved, maybe the
      link was mistyped. Either way, let's get you back on track.
    </p>
    <a href="/" class="text-link">Back to home</a>
  </main>
</BaseLayout>
