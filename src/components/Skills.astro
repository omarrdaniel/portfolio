---
const groups = [
  { label: 'Cloud & Security', items: 'AWS, Azure, Zero Trust, WAF, Firewall, CDN, AI Security' },
  { label: 'Automation & Scripting', items: 'Python, Bash, Terraform, Git, CI/CD, DevSecOps' },
  { label: 'Platforms', items: 'F5, Cloudflare, Akamai, Palo Alto Networks, Cisco' },
];
---

<section id="skills" class="section-divider">
  <div class="max-w-content mx-auto px-6 py-10">
    <p class="label mb-6">Skills</p>
    <div class="space-y-3">
      {groups.map((group) => (
        <p class="text-sm leading-relaxed">
          <span class="font-bold text-ink">{group.label}:</span>
          <span class="text-muted"> {group.items}</span>
        </p>
      ))}
    </div>
  </div>
</section>
